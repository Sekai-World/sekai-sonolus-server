{
  "include": ["./src"],
  "compilerOptions": {
    "lib": [
      "ES2024"
    ],
    "target": "ES2022",
    "module": "Node20",
    "moduleResolution": "Node16",
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"],
  }
}
